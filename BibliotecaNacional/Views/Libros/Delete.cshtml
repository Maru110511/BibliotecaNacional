@model BibliotecaNacional.Models.Libro

@{
    ViewData["Title"] = "Eliminar libro";
}

<h1>Eliminar libro</h1>

<h3>¿Está seguro de que desea eliminar este libro?</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Título
        </dt>
        <dd class="col-sm-9">
            @Model.Titulo
        </dd>

        <dt class="col-sm-3">
            Autor
        </dt>
        <dd class="col-sm-9">
            @Model.Autor
        </dd>

        <dt class="col-sm-3">
            Categoría
        </dt>
        <dd class="col-sm-9">
            @Model.Categoria
        </dd>

        <dt class="col-sm-3">
            Año de publicación
        </dt>
        <dd class="col-sm-9">
            @Model.AnioPublicacion
        </dd>

        <dt class="col-sm-3">
            Estado
        </dt>
        <dd class="col-sm-9">
            @Model.Estado
        </dd>

    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>