@model BibliotecaNacional.Models.Libro

@{
    ViewData["Title"] = "Detalles del libro";
}

<h1>Detalles del libro</h1>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Título
        </dt>
        <dd class="col-sm-9">
            @Model.Titulo
        </dd>

        <dt class="col-sm-3">
            Autor
        </dt>
        <dd class="col-sm-9">
            @Model.Autor
        </dd>

        <dt class="col-sm-3">
            Categoría
        </dt>
        <dd class="col-sm-9">
            @Model.Categoria
        </dd>

        <dt class="col-sm-3">
            Año de publicación
        </dt>
        <dd class="col-sm-9">
            @Model.AnioPublicacion
        </dd>

        <dt class="col-sm-3">
            Estado
        </dt>
        <dd class="col-sm-9">
            @Model.Estado
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver a la lista
    </a>
</div>